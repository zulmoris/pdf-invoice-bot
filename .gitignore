# ============================================
# .gitignore — файл, который Git игнорирует
# ============================================
# Представь, что это "черный список" файлов.
# Git просто не увидит эти файлы, как будто их нет.

# Секретный ключ от Google Sheets (НИКОГДА не публиковать!)
key.json

# Конфиг с путём к папке (у каждого пользователя свой путь)
config.json

# Файлы PDF-счетов (если менеджер киднет в эту папку)
*.pdf

# Временные файлы Python
__pycache__/
*.pyc

# Файл лога, если заведём
*.log
