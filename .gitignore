# ============================================
# .gitignore — файл, который Git игнорирует
# ============================================
# Представь, что это "черный список" файлов.
# Git просто не увидит эти файлы, как будто их нет.

# Секретный ключ от Google Sheets (НИКОГДА не публиковать!)
key.json

# Конфиг с путём к папке (у каждого пользователя свой путь)
config.json

# Файлы PDF-счетов (если менеджер киднет в эту папку)
*.pdf

# Временные файлы Python
__pycache__/
*.pyc

# Файл лога
errors.log

# Временные скрипты для отладки
_check.py
_read_sheet.py
_r.py

# Таблицы Excel (чужие данные, не для GitHub)
*.xlsx

# Секретный файл с токеном Telegram (если будет)
secrets.py

# Артефакты сборки (не коммитить — AGENTS.md)
build/
dist/
dist-test/
install_build/
__pycache__/

# Папки дистрибутивов версий и архивы
PDF-бот Аганим v*/
PDF-бот Аганим v*.zip

# Бэкап исходников (внутри key.json — НЕЛЬЗЯ на GitHub!)
ИСХОДНИКИ-*.zip

# Служебные папки инструментов
.zcode/
.mimosa/
gui-test-screenshots/

# Временные файлы отладки
_pf_*.txt
_pylint_*.txt
_*.py
!_update_version.ps1

